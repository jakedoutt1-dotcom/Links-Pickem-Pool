/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.jpeg
  Cache-Control: public, max-age=604800
/*.webp
  Cache-Control: public, max-age=604800
/manifest.webmanifest
  Cache-Control: public, max-age=86400
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache

/service-worker.js
  Cache-Control: no-store, no-cache, must-revalidate
/version.json
  Cache-Control: no-store, no-cache, must-revalidate
/*.js
  Cache-Control: no-cache

/new-build/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/new-build/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/new-build/*.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
/new-build/api/*
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/new-build/*.mjs
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/downloads/nfl-crew-windows.zip
  Content-Type: application/zip
  Content-Disposition: attachment; filename="LINKS-Pickem-Clean-Windows.zip"
  Cache-Control: public, max-age=3600

/downloads/nfl-crew-mac.zip
  Content-Type: application/zip
  Content-Disposition: attachment; filename="LINKS-Pickem-Clean-Mac.zip"
  Cache-Control: public, max-age=3600
